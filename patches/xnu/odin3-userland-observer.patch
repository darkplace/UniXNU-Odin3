+/* Read-only, once per observer tick. The list lock protects list membership;
+ * names are a transient diagnostic sample, not a task or thread reference. */
+void
+odin_boot_snapshot(unsigned *count, unsigned *mask)
+{
+	static const char *const names[] = {
+		"launchd", "logd", "backboardd", "SpringBoard",
+		"runningboardd", "watchdogd", "UserEventAgent"
+	};
+	proc_t process;
+	unsigned n = 0, bits = 0;
+	proc_list_lock();
+	ALLPROC_FOREACH(process) {
+		++n;
+		for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+			if (!strncmp(process->p_name, names[i], sizeof(process->p_name))) {
+				bits |= 1U << i;
+			}
+		}
+	}
+	proc_list_unlock();
+	*count = n;
+	*mask = bits;
+}
+#endif
